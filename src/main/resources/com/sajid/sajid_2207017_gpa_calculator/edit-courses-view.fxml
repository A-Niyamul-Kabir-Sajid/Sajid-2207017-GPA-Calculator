<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sajid.sajid_2207017_gpa_calculator.EditCoursesController"
            prefHeight="600.0" prefWidth="1000.0">
    
    <!-- Top: Student Info -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #34495e; -fx-padding: 15;">
            <Label fx:id="studentInfoLabel" 
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"
                   text="Roll: --- | Name: ---"/>
        </VBox>
    </top>
    
    <!-- Center: Table with editable cells -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            
            <Label text="Edit Course Details (Double-click cells to edit)" 
                   style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            
            <TableView fx:id="coursesTable" editable="true" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="yearColumn" text="Year" prefWidth="60" editable="true"/>
                    <TableColumn fx:id="termColumn" text="Term" prefWidth="60" editable="true"/>
                    <TableColumn fx:id="courseNameColumn" text="Course Name" prefWidth="180" editable="true"/>
                    <TableColumn fx:id="courseCodeColumn" text="Course Code" prefWidth="100" editable="true"/>
                    <TableColumn fx:id="creditColumn" text="Credit" prefWidth="70" editable="true"/>
                    <TableColumn fx:id="teacher1Column" text="Teacher 1" prefWidth="140" editable="true"/>
                    <TableColumn fx:id="teacher2Column" text="Teacher 2" prefWidth="140" editable="true"/>
                    <TableColumn fx:id="gradeColumn" text="Grade" prefWidth="80" editable="true"/>
                    <TableColumn fx:id="gradePointsColumn" text="Grade Points" prefWidth="100" editable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
            <!-- Summary Section -->
            <HBox spacing="30" alignment="CENTER" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-background-radius: 5;">
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Total Courses" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="totalCoursesLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Total Credits" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="totalCreditsLabel" text="0.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="CGPA" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="cgpaLabel" text="0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
    
    <!-- Bottom: Action Buttons -->
    <bottom>
        <HBox spacing="15" alignment="CENTER" style="-fx-padding: 15;">
            <Button text="Add New Course" onAction="#onAddCourseClick" 
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"
                    prefWidth="150"/>
            <Button text="Delete Selected" onAction="#onDeleteCourseClick" 
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"
                    prefWidth="150"/>
            <Button text="Save Changes" onAction="#onSaveClick" 
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"
                    prefWidth="150"/>
            <Button text="Cancel" onAction="#onCancelClick" 
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"
                    prefWidth="150"/>
        </HBox>
    </bottom>
    
</BorderPane>
