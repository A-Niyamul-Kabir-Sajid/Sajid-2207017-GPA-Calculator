<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="30.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sajid.sajid_2207017_gpa_calculator.HomeController">
    <padding>
        <Insets bottom="50.0" left="50.0" right="50.0" top="50.0"/>
    </padding>

    <Label text="Student GPA Calculator" styleClass="label-header">
        <font>
            <Font name="System Bold" size="32.0"/>
        </font>
    </Label>

    <Label text="Welcome to the GPA Calculator Application" styleClass="label-subheader">
        <font>
            <Font size="16.0"/>
        </font>
    </Label>

    <Label text="Track your courses and calculate your GPA easily" styleClass="label-info">
        <font>
            <Font size="14.0"/>
        </font>
    </Label>

    <Button text="Start GPA Calculator" onAction="#onStartButtonClick" styleClass="button-success">
        <font>
            <Font name="System Bold" size="16.0"/>
        </font>
    </Button>
</VBox>
