<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: #f0f0f0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sajid.sajid_2207017_gpa_calculator.StudentCoursesController">

    <!-- Top Section: Student Info -->
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #2196F3; -fx-padding: 20;">
            <Label text="Student Course Details" textFill="WHITE">
                <font>
                    <Font name="Arial Bold" size="28" />
                </font>
            </Label>
            <Label fx:id="studentInfoLabel" text="Student Information" textFill="WHITE">
                <font>
                    <Font name="Arial" size="16" />
                </font>
            </Label>
        </VBox>
    </top>

    <!-- Center Section: Courses Table -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            
            <!-- Summary Section -->
            <HBox spacing="30" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Total Courses" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                    <Label fx:id="totalCoursesLabel" text="0" style="-fx-font-size: 24; -fx-text-fill: #2196F3;" />
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Total Credits" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                    <Label fx:id="totalCreditsLabel" text="0.0" style="-fx-font-size: 24; -fx-text-fill: #4CAF50;" />
                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="CGPA" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                    <Label fx:id="cgpaLabel" text="0.00" style="-fx-font-size: 24; -fx-text-fill: #FF9800;" />
                </VBox>
            </HBox>
            
            <!-- Courses Table -->
            <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Course List" />
            <TableView fx:id="coursesTable" style="-fx-background-color: white; -fx-background-radius: 10;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="yearColumn" text="Year" prefWidth="60" />
                    <TableColumn fx:id="termColumn" text="Term" prefWidth="60" />
                    <TableColumn fx:id="courseNameColumn" text="Course Name" prefWidth="180" />
                    <TableColumn fx:id="courseCodeColumn" text="Course Code" prefWidth="120" />
                    <TableColumn fx:id="creditColumn" text="Credit" prefWidth="70" />
                    <TableColumn fx:id="teacher1Column" text="Teacher 1" prefWidth="150" />
                    <TableColumn fx:id="teacher2Column" text="Teacher 2" prefWidth="150" />
                    <TableColumn fx:id="gradeColumn" text="Grade" prefWidth="80" />
                    <TableColumn fx:id="gradePointsColumn" text="Grade Points" prefWidth="100" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- Bottom Section: Close Button -->
    <bottom>
        <HBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 15;">
            <Button onAction="#onCloseClick" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 10 30;" text="Close" />
        </HBox>
    </bottom>

</BorderPane>
