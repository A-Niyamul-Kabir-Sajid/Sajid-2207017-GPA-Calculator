<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sajid.sajid_2207017_gpa_calculator.CourseManagementController"
            prefHeight="650.0" prefWidth="800.0"
            style="-fx-background-color: #f0f0f0;">

    <!-- Top Section: Title -->
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #2196F3; -fx-padding: 20;">
            <Label text="Course Management" textFill="WHITE">
                <font>
                    <Font name="Arial Bold" size="28"/>
                </font>
            </Label>
            <Label text="Manage course information and statistics" textFill="WHITE">
                <font>
                    <Font name="Arial" size="14"/>
                </font>
            </Label>
        </VBox>
    </top>

    <!-- Center Section: Input Form and Table -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            
            <!-- Input Form -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label text="Course Information" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                
                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" prefWidth="120"/>
                        <ColumnConstraints minWidth="200" prefWidth="250"/>
                    </columnConstraints>
                    
                    <Label text="Course Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                           style="-fx-font-size: 14;"/>
                    <TextField fx:id="courseNameField" promptText="Enter course name" 
                               GridPane.columnIndex="1" GridPane.rowIndex="0"
                               style="-fx-font-size: 14;"/>
                    
                    <Label text="Course Code:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                           style="-fx-font-size: 14;"/>
                    <TextField fx:id="courseCodeField" promptText="Enter course code" 
                               GridPane.columnIndex="1" GridPane.rowIndex="1"
                               style="-fx-font-size: 14;"/>
                    
                    <Label text="Term Number:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                           style="-fx-font-size: 14;"/>
                    <TextField fx:id="termNumberField" promptText="Enter term number" 
                               GridPane.columnIndex="1" GridPane.rowIndex="2"
                               style="-fx-font-size: 14;"/>
                    
                    <Label text="Student Count:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                           style="-fx-font-size: 14;"/>
                    <TextField fx:id="studentCountField" promptText="Enter student count" 
                               GridPane.columnIndex="1" GridPane.rowIndex="3"
                               style="-fx-font-size: 14;"/>
                </GridPane>
                
                <!-- Action Buttons -->
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Add" onAction="#onAddClick" 
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 12; -fx-padding: 8 20;"
                            prefWidth="90"/>
                    <Button text="Load" onAction="#onLoadClick" 
                            style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 12; -fx-padding: 8 20;"
                            prefWidth="90"/>
                    <Button text="Update" onAction="#onUpdateClick" 
                            style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 12; -fx-padding: 8 20;"
                            prefWidth="90"/>
                    <Button text="Save" onAction="#onSaveClick" 
                            style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-size: 12; -fx-padding: 8 20;"
                            prefWidth="90"/>
                    <Button text="Find" onAction="#onFindClick" 
                            style="-fx-background-color: #00BCD4; -fx-text-fill: white; -fx-font-size: 12; -fx-padding: 8 20;"
                            prefWidth="90"/>
                    <Button text="Erase" onAction="#onEraseClick" 
                            style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-size: 12; -fx-padding: 8 20;"
                            prefWidth="90"/>
                </HBox>
            </VBox>
            
            <!-- Table View -->
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Course List" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                <TableView fx:id="courseTable" VBox.vgrow="ALWAYS" columnResizePolicy="CONSTRAINED_RESIZE_POLICY"
                          style="-fx-background-color: white; -fx-background-radius: 10;">
                    <columns>
                        <TableColumn text="Course Name" fx:id="courseNameColumn"/>
                        <TableColumn text="Course Code" fx:id="courseCodeColumn"/>
                        <TableColumn text="Term Number" fx:id="termNumberColumn"/>
                        <TableColumn text="Student Count" fx:id="studentCountColumn"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Section: Navigation Buttons -->
    <bottom>
        <HBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 15;">
            <Button text="← Back to Home" onAction="#onBackToHomeClick" 
                    style="-fx-background-color: #757575; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 10 30;"/>
            <Button text="Continue to Course Entry →" onAction="#onContinueToEntryClick" 
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 10 30;"/>
        </HBox>
    </bottom>

</BorderPane>
